{
  "expo": {
    "name": "Проверка белых списков",
    "slug": "test",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/eng/icon.png",
    "scheme": "testwhitelist",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zvezda4443.testwhitelist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["processing"]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/eng/android-icon-foreground.png",
        "backgroundImage": "./assets/images/eng/android-icon-background.png",
        "monochromeImage": "./assets/images/eng/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zvezda4443.testwhitelist",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/eng/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/eng/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FB",
          "dark": {
            "backgroundColor": "#10151C"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/eng/icon.png",
          "color": "#2196F3",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-background-task",
      "./plugins/withLocalizedAppName",
      "./plugins/withSiteProbe"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "311c21d1-6dd8-487a-bef5-648a0a9cc23d"
      }
    },
    "owner": "aleksey1234"
  }
}
