 class TaskManagerModule : Module() {
+  // SDK 54 does not tell React Native that TaskManager is doing background work.
+  // Keep timers active from event delivery until native task completion.
+  // Accessed only on the main thread; one token per event supports overlapping tasks.
+  private val timerTasks = mutableMapOf<String, Pair<HeadlessJsTaskContext, Int>>()
+  private val mainHandler = Handler(Looper.getMainLooper())
+
+  private fun startTimerTask(body: Bundle) {
+    val eventId = body.getBundle("executionInfo")?.getString("eventId") ?: return
+    if (timerTasks.containsKey(eventId)) return
+    val context = appContext.reactContext as? ReactContext ?: return
+    val tasks = HeadlessJsTaskContext.getInstance(context)
+    val taskId = tasks.startTask(HeadlessJsTaskConfig(
+      "whitelist-task-manager-timers", WritableNativeMap(), 120_000L, true
+    ))
+    timerTasks[eventId] = tasks to taskId
+    Log.i("ExpoTaskManager", "Started timer task $taskId for $eventId")
+  }
+
+  private fun finishTimerTask(eventId: String?) {
+    if (eventId == null) return
+    val (tasks, taskId) = timerTasks.remove(eventId) ?: return
+    tasks.finishTask(taskId)
+    Log.i("ExpoTaskManager", "Finished timer task $taskId for $eventId")
+  }
+
